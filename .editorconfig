root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true


[*.md]
# Force the usage of spaces in markdown docs because GitHub uses 8 wide tabs
#	by default
indent_style = space
max_line_length = off

# This must be disabled for Markdown files as using two spaces at the end of a
#   line is syntactically significant in Markdown
trim_trailing_whitespace = false


# Make sure shell scripts use the system specific line endings
[*.sh]
end_of_line = lf

[*.bat]
end_of_line = crlf


[*.py]
# If a python script is executed directly by bash (e.g. `foo.py` instead of
#   `python foo.py`), the script must use LF as its line endings or else the
#   CRLF line endings will cause bash to mis-parse the file.
end_of_line = lf

# PEP-8 recommends that indentation is handled with spaces.
# https://media.tenor.com/JzYtXjlc8o0AAAAC
indent_style = tab


[*.{xml,json,code-workspace,csproj,props,runsettings}]
indent_size = 2


# Use a smaller indent size for config files since those often have higher
#   levels of nesting
[**/*.{config.ts,config.js}]
indent_size = 2


[*.{yml,yaml}]
# YAML requires spaces to be used
indent_style = space
indent_size = 2
quote_type = double


# Prisma files tend to heavily use spaces for alignment, so it's easier to
#   use spaces for indentation too. This makes it so that alignment spaces can
#   be added by hitting tab instead of accidentally mixing spaces and tabs when
#   setting up alignment.
[*.prisma]
indent_style = space
# Save a little space at the beginning of the line by only using 2 spaces
indent_size = 2


[*.{html,cshtml,razor,tsx}]
# These files typically use high levels of indentation, so using a tab width
#   of 2 improves readability
indent_size = 2


[*.{css,scss}]
# Personal preference
indent_size = 2


[*.purs]
# The VSCode PureScript extension displays vertical indentation bars at 2
#   character intervals even if the indent size is 4, so just use 2 as the
#   indent size.
indent_size = 2

# PureScript requires the use of spaces for indentation
indent_style = space


[*.fs]
# F# requires the use of spaces for indentation
indent_style = space


# Verify settings
[*.{received,verified}.{txt,xml,json}]
charset = "utf-8-bom"
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false
