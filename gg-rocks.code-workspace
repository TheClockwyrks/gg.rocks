{
	// See:
	// - Original mention of `vscode://schemas/`: https://stackoverflow.com/a/78117666
	// - Schema registrations: https://github.com/microsoft/vscode/blob/61b3d0ab13be7dda2389f1d3e60a119c7f660cc3/src/vs/workbench/services/configuration/browser/configurationService.ts#L1304
	// - Schema ID: https://github.com/microsoft/vscode/blob/61b3d0ab13be7dda2389f1d3e60a119c7f660cc3/src/vs/workbench/services/configuration/common/configuration.ts#L22
	"$schema": "vscode://schemas/settings/workspace",
	"folders": [
		{
			"name": "Root",
			"path": "."
		},
	],
	"settings": {
		"editor.renderWhitespace": "boundary",
		"files.associations": {
			"*.hbars": "markdown"
		},
		"files.exclude": {
			// Autogenerated/default VSCode entries
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/CVS": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			// Custom entries
			"**/__pycache__": true,
			"**/.pytest_cache": true,
			"**/.mypy_cache": true,
			"**/node_modules": true,
			"**/bin": true,
			"**/obj": true,
		},
		"files.insertFinalNewline": true,
		"files.refactoring.autoSave": true,
		"files.trimFinalNewlines": true,
		// This must not be configured here as it will override the equivalent
		//   .editorconfig setting
		// "files.trimTrailingWhitespace": true,
		"markdown.extension.toc.orderedList": true,
		"shellcheck.ignorePatterns": {
			"**/.env*": true,
		},
		"workbench.editor.wrapTabs": true,
				"[markdown]": {
			"editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
			"editor.formatOnType": false,
			"editor.formatOnPaste": true,
			"editor.formatOnSave": true,
		},
	}
}
